# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in your own values.
# A native rebuild is required after changing any key (react-native-config
# generates native constants at build time — a Metro reload is not enough).
# ---------------------------------------------------------------------------

# WalletConnect Cloud project id — create one at https://cloud.reown.com
WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id

# Keychain aliases for secure storage (non-secret; any stable string works).
# Use your own app-specific identifiers.
BIOMETRIC_KEY=YOUR_APP_BIOMETRIC_KEY
PASSCODE_KEY=YOUR_APP_PASSCODE_KEY
SYNC_STORAGE_ID=your_app_sync_storage
SECURE_STORAGE_ID=your_app_secure_storage
SECURE_STORAGE_KEYCHAIN_ALIAS=YOUR_APP_SECURE_STORAGE_ENCRYPTION_KEY_ALIAS

# Moralis base URL (no key here — the key lives in keys.release.json)
SERVICE_MORALIS_API=https://deep-index.moralis.io/api/v2.2
SERVICE_ALCHEMY_DATA_API=https://api.g.alchemy.com/data/v1

# Your QuickNode endpoint name (the subdomain of your QuickNode RPC URL)
SERVICE_QUICKNODE_ENDPOINT_NAME=your_quicknode_endpoint_name

# Backend hosts — point these at your own backend when self-hosting.
# The values below are Keyring's public endpoints, kept as working defaults.
# Do NOT add a trailing slash to any host (the code appends path separators).
KEYRING_POOL_API=https://pool-data.keyring.app
COIN_POOL_API=https://api.coinpool.app
KEYRING_API=https://wallet-api.pantograph.app
NAGEMON_API=https://paymentapi.nagemon.com
EXCHANGE_API=https://exchange-api.keyring.app
RELAY_API=https://api.relay.link
X402_SERVER_API=https://keyring-agent.blockchhub.link
# Token price-history / price-change API
MINNADEFI_API=https://minnadefi-api.keyring.app


# Wallet that receives affiliate/referral fees on swap/bridge — use your own
AFFILIATE_FEE_RECIPIENT=0xYourAffiliateFeeRecipientAddress

# deBridge referral code (fee attribution) — use your own
REFERRAL_CODE=your_referral_code

# keyring account domain
KEYRING_ACCOUNT_DOMAIN=https://account.keyring.app