-static void postNotificationWithURL(NSURL *URL, id sender)
+// PATCH(keyring): hold on to an opened URL that has not reached JS yet.
+//
+// On an iOS app running on a Mac (Apple Silicon), a cold launch through a URL
+// scheme does NOT put the URL in launchOptions. macOS calls
+// application:openURL:options: ~0.5s after launch instead, while the JS bundle is
+// still loading, so nobody observes kOpenURLNotification yet and the link is
+// silently dropped (getInitialURL also returns null). On iPhone the same URL is in
+// launchOptions, so it was never lost there.
+//
+// Invariant: sPendingURL only ever holds a URL that JS has NOT received. It must
+// never outlive its delivery, otherwise a stale WalletConnect URI would be
+// replayed later.
+//  - set right before the notification is posted;
+//  - cleared synchronously when an observing instance forwards it as a `url`
+//    event (an observer exists only while JS has at least one `url` listener);
+//  - consumed by getInitialURL: returned at most once, then cleared.
+// Guarded by a lock; in practice all access is on the main thread.
+static NSString *sPendingURL = nil;
+
+static NSObject *pendingURLLock(void)
+{
+  static NSObject *lock;
+  static dispatch_once_t onceToken;
+  dispatch_once(&onceToken, ^{
+    lock = [NSObject new];
+  });
+  return lock;
+}
+
+static void postNotificationWithURLString(NSString *URLString, id sender)
 {
-  NSDictionary<NSString *, id> *payload = @{@"url" : URL.absoluteString};
+  if (URLString == nil) {
+    return;
+  }
+  @synchronized(pendingURLLock()) {
+    sPendingURL = URLString;
+  }
+  NSDictionary<NSString *, id> *payload = @{@"url" : URLString};
   [[NSNotificationCenter defaultCenter] postNotificationName:kOpenURLNotification object:sender userInfo:payload];
 }
 
+static void postNotificationWithURL(NSURL *URL, id sender)
+{
+  postNotificationWithURLString(URL.absoluteString, sender);
+}
