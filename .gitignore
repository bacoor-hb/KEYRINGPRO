ios/GoogleService-Info.plist

# Internal AI/dev assistant config (.agents/, .claude/, .codex/, .gemini/,
# .github/, .opencode/, CLAUDE.md, __app_settings/) is intentionally NOT ignored
# here — devs add & commit these to the PRIVATE repo, so ignoring the dirs would
# block new files. They are stripped from the public tree by
# notes/sync-public.sh (DROP_PATHS + value scan), NOT by .gitignore.
# Personal, non-shared files stay ignored individually (see the
# .claude/settings.local.json rule above).
