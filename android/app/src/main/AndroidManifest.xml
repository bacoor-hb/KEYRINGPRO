<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.CAMERA" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.WAKE_LOCK" />
  <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
  <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
  <uses-permission android:name="android.permission.VIBRATE" />
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
  <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
  <uses-permission android:name="android.permission.NFC" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <uses-permission android:name="android.permission.USE_CREDENTIALS" />
  <uses-permission android:name="android.permission.DETECT_SCREEN_CAPTURE" />

  <queries>
    <intent>
      <action android:name="android.intent.action.VIEW" />
      <data android:scheme="http" />
    </intent>
    <intent>
      <action android:name="android.intent.action.VIEW" />
      <data android:scheme="https" />
    </intent>
  </queries>

  <application
    android:largeHeap="true"
    android:name=".MainApplication"
    android:label="@string/app_name"
    android:icon="@mipmap/ic_launcher"
    android:allowBackup="false"
    android:theme="@style/AppTheme"
    android:supportsRtl="true">
    <activity
      android:name=".MainActivity"
      android:label="@string/app_name"
      android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
      android:launchMode="singleTask"
      android:windowSoftInputMode="adjustPan"
      android:exported="true"
      android:theme="@style/BootTheme"
      android:screenOrientation="portrait">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>

      <intent-filter android:label="KEYRING PRO">
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.BROWSABLE" />
        <data android:scheme="wc" />
      </intent-filter>

      <intent-filter android:label="KEYRING PRO">
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.BROWSABLE" />

        <data
          android:scheme="keyring"
          android:host="wc" />
        <data
          android:scheme="keyring"
          android:host="open-keyring-app" />
        <data
          android:scheme="keyring"
          android:host="receive-link" />
        <data
          android:scheme="keyring"
          android:host="receivelink" />
        <data
          android:scheme="keyring"
          android:host="campaign" />
        <data
          android:scheme="keyring"
          android:host="nft-card" />
        <data
          android:scheme="keyring"
          android:host="how-to-scan" />
        <data
          android:scheme="keyring"
          android:host="how-to-scan-necostore" />
        <data
          android:scheme="keyring"
          android:host="necostore/nft-card" />
        <data
          android:scheme="keyring"
          android:host="nfc-campaign" />
        <data
          android:scheme="keyring"
          android:host="how-to-scan-misssake" />
        <data
          android:scheme="keyring"
          android:host="how-to-scan-misssake-nfc" />
        <data
          android:scheme="keyring"
          android:host="nfc-fanymaket-campaign" />
        <data
          android:scheme="keyring"
          android:host="how-to-scan-fanymarket" />
      </intent-filter>

      <intent-filter
        android:label="KEYRING PRO"
        android:autoVerify="true">
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.BROWSABLE" />

        <data
          android:scheme="https"
          android:host="keyring.app"
          android:pathPrefix="/open-keyring-app" />
        <data
          android:scheme="https"
          android:host="keyring.app"
          android:pathPrefix="/wallet-connect" />
        <data
          android:scheme="https"
          android:host="keyring.app"
          android:pathPrefix="/wc" />
        <data
          android:scheme="https"
          android:host="keyring.app"
          android:pathPrefix="/campaign" />
        <data
          android:scheme="https"
          android:host="keyring.app"
          android:pathPrefix="/necostore/nft-card" />

        <data
          android:scheme="https"
          android:host="sign.keyringpro.com"
          android:pathPrefix="/how-to-scan" />
        <data
          android:scheme="https"
          android:host="sign.keyringpro.com"
          android:pathPrefix="/nfc-campaign" />

        <data
          android:scheme="https"
          android:host="sign.keyringpro.com"
          android:pathPrefix="/how-to-scan-necostore" />

        <data
          android:scheme="https"
          android:host="sign.keyringpro.com"
          android:pathPrefix="/how-to-scan-misssake-nfc" />
        <data
          android:scheme="https"
          android:host="sign.keyringpro.com"
          android:pathPrefix="/how-to-scan-misssake" />

        <data
          android:scheme="https"
          android:host="sign.keyringpro.com"
          android:pathPrefix="/nfc-fanymaket-campaign" />
        <data
          android:scheme="https"
          android:host="sign.keyringpro.com"
          android:pathPrefix="/how-to-scan-fanymarket" />

        <data
          android:scheme="https"
          android:host="keyring.app"
          android:pathPrefix="/add-chain" />

        <data
          android:scheme="https"
          android:host="sign-dev.keyringpro.com"
          android:pathPrefix="/how-to-scan" />
        <data
          android:scheme="https"
          android:host="sign-dev.keyringpro.com"
          android:pathPrefix="/nfc-campaign" />

        <data
          android:scheme="https"
          android:host="sign-dev.keyringpro.com"
          android:pathPrefix="/how-to-scan-necostore" />

        <data
          android:scheme="https"
          android:host="sign-dev.keyringpro.com"
          android:pathPrefix="/how-to-scan-misssake-nfc" />
        <data
          android:scheme="https"
          android:host="sign-dev.keyringpro.com"
          android:pathPrefix="/how-to-scan-misssake" />

        <data
          android:scheme="https"
          android:host="sign-dev.keyringpro.com"
          android:pathPrefix="/nfc-fanymaket-campaign" />
        <data
          android:scheme="https"
          android:host="sign-dev.keyringpro.com"
          android:pathPrefix="/how-to-scan-fanymarket" />
      </intent-filter>
    </activity>
  </application>
</manifest>
